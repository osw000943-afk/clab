# clab — WhiteHat Lab configuration (example)
# Copy to .env and fill in real values. NEVER commit .env.

# HTTP server
NODE_ENV=production
PORT=3000
# Bind address. Keep 127.0.0.1 behind a reverse proxy; 0.0.0.0 only on private lab hosts.
HOST=127.0.0.1

# Storage
DATA_DIR=./data
DB_PATH=./data/clab.db

# Auth — generate with: npm run set-password  (writes LAB_PASSWORD_HASH here)
LAB_PASSWORD_HASH=
# Generate with: npm run gen-key
SESSION_SECRET=
# 32-byte base64 key used to encrypt stored secrets (AI API keys, DB credentials).
# Must NOT be stored in the database — env only.
ENCRYPTION_KEY=

# Session policy (minutes / hours)
SESSION_IDLE_MIN=30
SESSION_ABSOLUTE_H=8

# Logging (rotating files under LOG_DIR)
LOG_DIR=./logs
LOG_MAX_KB=512
LOG_KEEP=3

# Scanner resource limits (can also be tuned in Settings → System)
MAX_SCAN_DURATION_MIN=45
TOOL_TIMEOUT_MS=300000
MAX_PORT_COUNT=64
MAX_PROBE_PATHS=60
